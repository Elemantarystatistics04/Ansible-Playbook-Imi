services:
  hermes-agent:
    image: nousresearch/hermes-agent:latest
    container_name: hermes-agent
    restart: unless-stopped
    stdin_open: true
    tty: true
    environment:
      - OPENROUTER_API_KEY={{ vault_hermes_openrouter_key }}
      - HERMES_HOME=/root/.hermes
    volumes:
      - hermes_data:/root/.hermes

volumes:
  hermes_data:
